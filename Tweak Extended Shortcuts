[#DownloadProgram#]
// ===============================================================================================================================
// Name...........: DownloadProgram
// Description....: Download the program files from the script file
// Syntax.........: Run,%ScriptFile%,DownloadProgram
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........:
// Related........: PEStartup_x86.exe
// ===============================================================================================================================
[DownloadProgram] 

If,%cb_AlwaysDownload%,Equal,False,begin 
  Echo,"Downloading %ProgramExe% and %TheOven_Startup%..."
  ExtractFile,%ScriptFile%,"PEStartup","%ProgramExe%","%ProgramsCache%\%ProgramFolder%"
  ExtractFile,%ScriptFile%,"PEStartup","%TheOven_Startup%","%ProgramsCache%\%ProgramFolder%"
end
