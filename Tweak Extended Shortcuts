[#Links#]
// ===============================================================================================================================
// Name...........: Links
// Description....: Loop the Links.
// Syntax.........: 
// Parameters.....: 
// Return values..: 
// Author.........: Cookiebaker
// Remarks........: 
// Related........: 
// ===============================================================================================================================
[Links]

// Check if set to X:\ or Y:\ delete path
StrFormat,Left,%FileBox_#c%,3,%Drive%

If,%Drive%,Equal,"X:\",begin
echo,"Drive not valid. X:\ is not possible"
WriteInterface,Value,%ScriptFile%,Interface,FileBox_#c,""
end

If,%Drive%,Equal,"Y:\",begin
echo,"Drive not valid. Y:\ is not possible"
WriteInterface,Value,%ScriptFile%,Interface,FileBox_#c,""
end

If,Not,%FileBox_#c%,Equal,"",begin

   // Get the file
   StrFormat,FileName,%FileBox_#c%,%file_#c%

   // Get the path
   StrFormat,DirPath,%FileBox_#c%,%myVar%
   StrFormat,EndTrim,%myVar%,\,%myV%
   StrFormat,Split,%myV%,\,0,%SplitCount%
   StrFormat,Split,%myV%,\,%SplitCount%,%myDir%

   Set,%ProgramFolder%,%myDir%
   Set,%ProgramExeFile%,%file_#c%

   Set,%txt_ShortcutName%,%file_#c%
   Set,%txt_StartMenuFolder%,%cmb_Applications_#c%
   
   If,%SourceArch%,Equal,x64,Begin
     Set,%proc%,x64
   End
   Else,Begin
       Set,%proc%,x86
   End

   ////////////////////////////////////
   // Decide internal or external

   If,"%BaseDir%\Workbench\Additional\%proc%\boot.wim\Program Files\%myDir%\%file_#c%",Equal,%FileBox_#c%,begin
     // internal  e.g.: %FileBox01% = %BaseDir%\Workbench\Additional\x64\boot.wim\Program Files\78RePack\78RePack.exe 

     Set,%Destination%,"%PEPrograms%\%ProgramFolder%\%ProgramExeFile%"
     Set,%Execution%,"%PEPrograms%\%ProgramFolder%"
	 
	
     if,Not,ExistFile,"%TargetPrograms%\%ProgramFolder%\%ProgramExeFile%",begin
       DirMake,"%TargetPrograms%\%ProgramFolder%"
       DirCopy,"%BaseDir%\Workbench\Additional\%SourceArch%\boot.wim\Program Files\%ProgramFolder%","%TargetPrograms%"
     end
   end
   Else,Begin
    // external  e.g.: %FileBox01% = F:\Start.exe

     Set,%Destination%,%FileBox_#c%
     Set,%Execution%,"%PEPrograms%\%myDir%"  
   end
   
  // Shortcuts for Extended Shortcuts                                    
    if,%cmb_Applications_#c%,Equal,"Autostart",set,%txt_StartMenuFolder%,Startup
  
    If,%cb_StartMenuShc_#c%,Equal,True,AddShortcut,StartMenu,%txt_StartMenuFolder%,%txt_ShortcutName%,%Destination%,"",%Execution%
    If,%cb_DesktopShc_#c%,Equal,True,AddShortcut,Desktop,"",%txt_ShortcutName%,%Destination%,"",%Execution%
    If,%cb_PinToTaskbar_#c%,Equal,True,PinShortcut,Taskbar,Auto,%Destination%
    If,%cb_PinToStartMenu_#c%,Equal,True,PinShortcut,StartMenu,Auto,%Destination%

end


