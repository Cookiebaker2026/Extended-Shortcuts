[Main]
Title=Extended Shortcuts
Author=Cookiebaker
Level=4
Version=1.0.1.1
Description=Generate shortcuts from additional applications or external files with PEStartup (v1.1.7.0) or plugin. Together with StartAllBack and Explorer Shell Plugin.
Date=2025.12.22
Selected=True
Mandatory=False

[Variables]
%ProgramFolder%="PEStartup"
%ProgramExe%="PEStartup_%SourceArch%.exe"
%TheOven_Startup%="TheOven_Startup.exe"

%DownloadURLx86%="https://rmprepusb.com/wp-content/uploads/2022/10/PEStartup_Papps_v1.zip"
%DownloadURLx64%="https://rmprepusb.com/wp-content/uploads/2022/10/PEStartup_Papps_v1.zip"
%SetupFile%=PEStartup_Papps_v1.zip

//%DownloadURLx86%="https://rmprepusb.com/wp-content/uploads/2022/10/PEStartup_v3.zip"
//%DownloadURLx64%="https://rmprepusb.com/wp-content/uploads/2022/10/PEStartup_v3.zip"
//%SetupFile%=PEStartup_v3.zip


[Process]

Echo,"Processing %ScriptTitle%..."

If,%cb_RunFromRam%,Equal,True,RunFromRam

If,%cb_AlwaysDownload%,Equal,True,begin
  If,ExistDir,"%ProgramsCache%\%ProgramFolder%",DirDeleteEx,"%ProgramsCache%\%ProgramFolder%" 
  Run,%ScriptFile%,DownloadProgram
end
else,If,Not,ExistDir,"%ProgramsCache%\%ProgramFolder%",begin
  Run,%ScriptFile%,DownloadProgram
end

if,Not,%cmb_DrivePath%,Equal,"void",begin
  // no external drives only X: or Y:
  if,%cmb_DrivePath%,Equal,"off",begin
    FileCopy,"%ProgramsCache%\%ProgramFolder%\%ProgramExe%","%TargetPrograms%\%ProgramFolder%\%ProgramExe%"
    FileCopy,"%ProgramsCache%\%ProgramFolder%\%TheOven_Startup%","%TargetPrograms%\%ProgramFolder%\%TheOven_Startup%"
  end
   else,begin
     // external drives D:,E:,...,L:
     If,ExistDir,%cmb_DrivePath%,Begin
       Set,%PEPrograms%,"%cmb_DrivePath%\Program Files"
       If,Not,ExistFile,"%PEPrograms%\%ProgramFolder%",DirMake,"%PEPrograms%\%ProgramFolder%"
       FileCopy,"%ProgramsCache%\%ProgramFolder%\%ProgramExe%","%PEPrograms%\%ProgramFolder%"
       FileCopy,"%ProgramsCache%\%ProgramFolder%\%TheOven_Startup%","%PEPrograms%\%ProgramFolder%"
     end 
   end
end 

// clear %SetupFile% from Web download in %ProgramsCache% folder
If,%cb_AlwaysDownload%,Equal,True,begin
  If,ExistFile,%ProgramsCache%\%ProgramFolder%\%SetupFile%,FileDelete,%ProgramsCache%\%ProgramFolder%\%SetupFile%
end 


///////////////////////////////////////////////////////////////////////////////////
// Shortcuts for PEStartup	

if,Not,%cmb_DrivePath%,Equal,"void",begin
     If,%cb_DesktopShc%,Equal,True,AddAutorun,PostShell,NoWait,"Starting %TheOven_Startup%","%PEPrograms%\%ProgramFolder%\%TheOven_Startup%"
     If,%cb_StartMenuShc%,Equal,True,AddShortcut,StartMenu,%txt_StartMenuFolder%,%txt_ShortcutName%,"%PEPrograms%\%ProgramFolder%\%ProgramExe%","","%PEPrograms%\%ProgramFolder%"
