End
If,ExistDir,"J:\",Begin
  Set,%Found%,"%Found% J:"
End
If,ExistDir,"K:\",Begin
  Set,%Found%,"%Found% K:"
End
If,ExistDir,"L:\",Begin
  Set,%Found%,"%Found% L:"
