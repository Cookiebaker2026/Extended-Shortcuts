  Set,%Msg%,"Found external drives: %Found%"
End

// drive set
If,Not,ExistDir,"%cmb_DrivePath%",Begin
  Set,%Msg%,"%Msg% #$xDrive %cmb_DrivePath% not exists!"
  If,%cmb_DrivePath%,Equal,"off",begin 
    If,%cb_RunFromRam%,Equal,True,begin  
	  Set,%Msg%,"#$x%ProgramExe% is in folder:#$xX:\Program Files\%ProgramFolder%"
